server {
    listen 80;
    listen [::]:80;
    server_name {{ robin_tools_domain }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ robin_tools_letsencrypt_webroot }};
        default_type "text/plain";
    }

{% if robin_tools_enable_letsencrypt | bool and robin_tools_nginx_has_certificate | bool %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    location / {
        proxy_pass http://127.0.0.1:{{ robin_tools_local_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
        client_max_body_size {{ robin_tools_nginx_client_max_body_size }};

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    }
{% endif %}
}

{% if robin_tools_enable_letsencrypt | bool and robin_tools_nginx_has_certificate | bool %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ robin_tools_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ robin_tools_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ robin_tools_domain }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:{{ robin_tools_local_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
        client_max_body_size {{ robin_tools_nginx_client_max_body_size }};

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    }
}
{% endif %}
