ROBIN_TOOLS_DB_PASSWORD={{ robin_tools_db_password | to_json }}
ROBIN_TOOLS_MODULE_PROXY_SECRET={{ robin_tools_module_proxy_secret | to_json }}
{% if robin_tools_auth_mode == 'basic' %}
{# bcrypt hashes contain $ characters, which docker compose treats as variable
   interpolation inside .env files, so every $ must be doubled to $$ here. #}
ROBIN_TOOLS_AUTH_PASSWORD_HASH={{ (robin_tools_admin_password | password_hash('bcrypt', rounds=12) | replace('$', '$$')) | to_json }}
{% else %}
ROBIN_TOOLS_AUTH_PASSWORD_HASH=""
{% endif %}
