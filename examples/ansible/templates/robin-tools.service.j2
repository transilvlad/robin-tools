[Unit]
Description=Robin Tools Docker Compose application
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ robin_tools_install_dir }}
ExecStart=/usr/bin/docker compose --env-file .env up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose --env-file .env down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
