# Copy to .env in this directory, then:
#   docker compose up -d --build

# Robin Tools joins the same Docker network as the rest of the Robin Admin
# suite (default name: suite_suite) and reaches the suite's shared PostgreSQL
# instance as postgres-backend, exactly like the repository root
# docker-compose.yaml. This file differs from that one only by always
# requiring NODE_ENV=production and by living alongside the standalone
# example for comparison.

ROBIN_SUITE_NETWORK=suite_suite

ROBIN_TOOLS_DB_HOST=postgres-backend
ROBIN_TOOLS_DB_PORT=5432
ROBIN_TOOLS_DB_NAME=robin
ROBIN_TOOLS_DB_USER=robin

# Must match the Robin Admin suite's shared database password.
ROBIN_TOOLS_DB_PASSWORD=CHANGE_ME_TO_MATCH_ROBIN_ADMIN

# Must match the module secret Robin Admin is configured to send to the
# "robin-tools" module. Generate with: openssl rand -base64 48
ROBIN_TOOLS_MODULE_PROXY_SECRET=CHANGE_ME_TO_MATCH_ROBIN_ADMIN

# Optional
ROBIN_PTR_RESOLVERS=
ROBIN_TOOLS_ALLOW_PRIVATE_PROBES=false
