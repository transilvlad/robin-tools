# Normalize text files to LF in both the repository and working tree.
* text=auto eol=lf

# Source, configuration, documentation, and container files use LF explicitly.
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.json     text eol=lf
*.json5    text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.conf     text eol=lf
*.properties text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Windows scripts retain CRLF for native execution.
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Raw messages must retain their exact bytes for parsing and signature checks.
*.eml      -text -diff -merge !eol

# Binary assets are never converted or diffed as text.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.avif     binary
*.pdf      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.mp3      binary
*.mp4      binary
*.ogg      binary
*.wav      binary
*.webm     binary
*.gz       binary
*.tar      binary
*.zip      binary
