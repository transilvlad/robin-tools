{
  "name": "robin-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Robin Tools standalone federated app",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/transilvlad/robin-tools"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "build:standalone": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build --config vite.config.standalone.ts",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "vitest run src/moduleApi.test.ts src/encoding.test.ts src/ui.test.tsx",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js . --fix",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx}\" \"*.{js,ts}\"",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{ts,tsx}\" \"*.{js,ts}\""
  },
  "dependencies": {
    "lucide-react": "^1.44.0",
    "pako": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@module-federation/vite": "^1.21.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "adm-zip": "^0.6.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
