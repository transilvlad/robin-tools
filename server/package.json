{
  "name": "robin-tools-server",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "hash-password": "node scripts/hash-password.mjs",
    "test": "npm run build && node --experimental-test-module-mocks --test dist/services/*.test.js dist/routes/*.test.js dist/middleware/*.test.js",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.ts\"",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "ipaddr.js": "^2.3.0",
    "pg": "^8.13.0",
    "psl": "^1.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.11.10",
    "@types/psl": "^1.11.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
