# Copy to .env.standalone before running:
#   docker compose -f docker-compose.standalone.yaml --env-file .env.standalone up -d --build

# A strong password for the bundled Postgres instance.
DB_PASSWORD=

# Any long random value. Standalone mode has no host to proxy through, so this
# only guards the legacy module-proxy header scheme against other local callers.
MODULE_PROXY_SECRET=

# none: no login (only for trusted/offline/local-machine use)
# basic: single-user HTTP Basic Auth (recommended for anything reachable by others)
ROBIN_TOOLS_AUTH_MODE=basic
ROBIN_TOOLS_AUTH_USERNAME=admin

# Required when ROBIN_TOOLS_AUTH_MODE=basic. Generate with:
#   cd server && npm run hash-password -- 'your-password'
# IMPORTANT: bcrypt hashes contain $ characters, which docker compose treats
# as variable interpolation inside .env files. Double every $ as $$, e.g.
# $2b$12$abc... becomes $$2b$$12$$abc...
ROBIN_TOOLS_AUTH_PASSWORD_HASH=

# Optional
ROBIN_TOOLS_PORT=3003
ROBIN_PTR_RESOLVERS=
ROBIN_TOOLS_ALLOW_PRIVATE_PROBES=false
